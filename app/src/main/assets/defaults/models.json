{
  // Same format as F:\AI-Agents\ashley\config\models.json, with phone engines added.
  //   provider "fake"     = built-in demo engine (no model needed) - for testing the UI and agent loop
  //   provider "llamacpp" = on-device GGUF via llama.cpp (Qwen3.5, next step)   file = path under the app's files folder
  //   provider "litert"   = on-device .litertlm via Google LiteRT-LM (Gemma 4)
  //   provider "openai"   = any OpenAI-compatible server: llama-server on the PC, or Ollama's /v1
  //   provider "ollama"   = Ollama, uses its OpenAI-compatible /v1 endpoint
  "models": [
    {
      "name": "gemma4-e4b",
      "description": "Gemma 4 E4B - default: fast and cool on the GPU, sees images",
      "provider": "litert",
      "file": "models/gemma-4-E4B-it.litertlm",
      "backend": "gpu",
      "contextSize": 8192,
      "temperature": 0.7,
      "maxTokens": 2048,
      "supportsTools": true,
      "think": false
    },
    {
      "name": "qwen3.5-4b",
      "description": "Qwen3.5 4B - for tricky, multi-step jobs (thinking on demand)",
      "provider": "llamacpp",
      "file": "models/Qwen3.5-4B-Q4_K_M.gguf",
      "backend": "cpu",
      "contextSize": 16384,
      "temperature": 0.7,
      "maxTokens": 2048,
      "threads": 6,
      "supportsTools": true,
      "think": false
    },
    {
      "name": "pc-qwen3-coder-30b",
      "description": "The 30B on the PC via llama-server - set baseUrl to your PC's IP or Tailscale name",
      "provider": "openai",
      "baseUrl": "http://YOUR-PC:8080/v1",
      "model": "qwen3-coder-30b",
      "contextSize": 32768,
      "temperature": 0.3,
      "maxTokens": 4096,
      "supportsTools": true
    },
    {
      "name": "demo",
      "description": "Built-in demo engine - shows the UI and a tool call, no model needed",
      "provider": "fake",
      "contextSize": 16384,
      "supportsTools": true
    }
  ]
}
